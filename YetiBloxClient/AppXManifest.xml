<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  IgnorableNamespaces="uap mp">

  <!-- 1. IDENTIDADE DO PACOTE -->
  <!-- Name: Nome do pacote no sistema (sem espaços nem caracteres especiais) -->
  <!-- Publisher: ID de quem criou -->
  <Identity
    Name="YetiBlox.NoobloxDev"
    Publisher="CN=NoobloxDev"
    Version="1.0.0.0" />

  <!-- 2. PROPRIEDADES DE EXIBIÇÃO -->
  <Properties>
    <DisplayName>YetiBlox</DisplayName>
    <PublisherDisplayName>NOOBLOX_dev</PublisherDisplayName>
    <Logo>gemini-svg.ico</Logo>
  </Properties>

  <!-- 3. COMPATIBILIDADE DE DISPOSITIVO (Windows 10 / Xbox) -->
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22000.0" />
  </Dependencies>

  <Resources>
    <Resource Language="pt-BR" />
  </Resources>

  <!-- 4. PONTO DE ENTRADA DO JOGO -->
  <Applications>
    <Application Id="App"
      Executable="Roblox.exe"
      EntryPoint="Windows.FullTrustApplication">
      
      <uap:VisualElements
        DisplayName="YetiBlox"
        Description="YetiBlox Client!"
        BackgroundColor="#000000"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
      </uap:VisualElements>
    </Application>
  </Applications>

  <!-- 5. PERMISSÕES E CAPACIDADES -->
  <Capabilities>
    <Capability Name="internetClient" />
  </Capabilities>

</Package>